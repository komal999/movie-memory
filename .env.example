# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movie_memory"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Needed for `next start` / behind a proxy (next dev trusts localhost automatically).
# In production prefer AUTH_URL="https://your-domain".
AUTH_TRUST_HOST=true
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI (server-only; never prefixed with NEXT_PUBLIC_)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
